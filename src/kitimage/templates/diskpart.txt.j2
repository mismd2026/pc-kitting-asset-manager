rem {{ name }}: UEFI/GPT layout (System / MSR / Windows / Recovery)
select disk {{ p.image.disk.number | default(0) }}
clean
convert gpt
create partition efi size=260
format quick fs=fat32 label="System"
assign letter="S"
create partition msr size=16
create partition primary
shrink minimum={{ p.image.disk.recovery_partition_mb | default(1024) }}
format quick fs=ntfs label="{{ p.image.disk.os_partition_label | default('Windows') }}"
assign letter="W"
create partition primary
format quick fs=ntfs label="Recovery"
assign letter="R"
set id="de94bba4-06d1-4d40-a16a-bfd50179d6ac"
gpt attributes=0x8000000000000001
list volume
exit
